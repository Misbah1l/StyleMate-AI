<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="YOUR PERSONAL FASHION SPACE"
                    android:textColor="@color/soft_brown"
                    android:textSize="10sp"
                    android:letterSpacing="0.12" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="StyleMate"
                    android:textColor="@color/text_black"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:fontFamily="serif" />

            </LinearLayout>

            <ImageView
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:padding="9dp"
                android:background="@drawable/logo_background"
                android:src="@drawable/stylemate_logo"
                android:scaleType="fitCenter"
                android:contentDescription="StyleMate logo" />

        </LinearLayout>

        <!-- Greeting -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="Discover Your Style."
            android:textColor="@color/text_black"
            android:textSize="27sp"
            android:textStyle="bold"
            android:fontFamily="serif" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="A little inspiration for your everyday look."
            android:textColor="@color/soft_brown"
            android:textSize="14sp" />

        <!-- AI Stylist Feature Card -->
        <LinearLayout
            android:id="@+id/ai_stylist_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="240dp"
            android:layout_marginTop="26dp"
            android:background="@color/dark_brown"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:padding="22dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STYLEMATE INTELLIGENCE"
                android:textColor="#E9DFD2"
                android:textSize="10sp"
                android:letterSpacing="0.16" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:text="Meet Your AI\nFashion Stylist"
                android:textColor="@color/white"
                android:textSize="27sp"
                android:textStyle="bold"
                android:fontFamily="serif"
                android:lineSpacingExtra="2dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Personalized inspiration, made for your style."
                android:textColor="#F0E6DC"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="EXPLORE AI STYLING   →"
                android:textColor="#E9DFD2"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

        </LinearLayout>

        <!-- Categories Heading -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Explore Categories"
                android:textColor="@color/text_black"
                android:textSize="21sp"
                android:textStyle="bold"
                android:fontFamily="serif" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VIEW ALL"
                android:textColor="@color/dark_brown"
                android:textSize="10sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Category Cards -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="105dp"
                    android:layout_height="76dp"
                    android:layout_marginEnd="10dp"
                    android:background="@color/beige"
                    android:gravity="center"
                    android:text="01\nClothing"
                    android:textColor="@color/text_black"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="105dp"
                    android:layout_height="76dp"
                    android:layout_marginEnd="10dp"
                    android:background="@color/white"
                    android:gravity="center"
                    android:text="02\nShoes"
                    android:textColor="@color/text_black"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="105dp"
                    android:layout_height="76dp"
                    android:layout_marginEnd="10dp"
                    android:background="@color/white"
                    android:gravity="center"
                    android:text="03\nAccessories"
                    android:textColor="@color/text_black"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="105dp"
                    android:layout_height="76dp"
                    android:background="@color/white"
                    android:gravity="center"
                    android:text="04\nOutfits"
                    android:textColor="@color/text_black"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </HorizontalScrollView>

        <!-- Features Heading -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Your Style Toolkit"
            android:textColor="@color/text_black"
            android:textSize="21sp"
            android:textStyle="bold"
            android:fontFamily="serif" />

        <!-- Wardrobe Card -->
        <LinearLayout
            android:id="@+id/wardrobe_card"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginTop="16dp"
            android:background="@color/beige"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="MY DIGITAL WARDROBE"
                    android:textColor="@color/text_black"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Organize your fashion collection"
                    android:textColor="@color/dark_brown"
                    android:textSize="12sp" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="→"
                android:textColor="@color/dark_brown"
                android:textSize="25sp" />

        </LinearLayout>

        <!-- AI Scanner Card -->
        <LinearLayout
            android:id="@+id/scanner_card"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginTop="12dp"
            android:background="@color/white"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="AI OUTFIT SCANNER"
                    android:textColor="@color/text_black"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Recognize your clothing items"
                    android:textColor="@color/dark_brown"
                    android:textSize="12sp" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="→"
                android:textColor="@color/dark_brown"
                android:textSize="25sp" />

        </LinearLayout>

        <!-- Planner Card -->
        <LinearLayout
            android:id="@+id/planner_card"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginTop="12dp"
            android:background="@color/white"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="OUTFIT PLANNER"
                    android:textColor="@color/text_black"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Plan looks for every occasion"
                    android:textColor="@color/dark_brown"
                    android:textSize="12sp" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="→"
                android:textColor="@color/dark_brown"
                android:textSize="25sp" />

        </LinearLayout>

        <!-- Footer -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="12dp"
            android:text="FASHION  •  AI  •  YOUR WARDROBE"
            android:textColor="@color/soft_brown"
            android:textSize="10sp"
            android:letterSpacing="0.12" />

    </LinearLayout>

</ScrollView>
