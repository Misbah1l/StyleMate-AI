<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream">

    <!-- Decorative Top Line -->
    <View
        android:id="@+id/top_line"
        android:layout_width="55dp"
        android:layout_height="2dp"
        android:background="@color/soft_brown"
        android:layout_marginTop="65dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Fashion Logo with Brown Circle -->
    <ImageView
        android:id="@+id/logo"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:src="@drawable/stylemate_logo"
        android:background="@drawable/logo_circle_background"
        android:padding="28dp"
        android:scaleType="fitCenter"
        android:contentDescription="StyleMate Fashion Logo"
        android:layout_marginTop="35dp"
        app:layout_constraintTop_toBottomOf="@id/top_line"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- App Name -->
    <TextView
        android:id="@+id/app_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="StyleMate"
        android:textColor="@color/text_black"
        android:textSize="36sp"
        android:fontFamily="serif"
        android:textStyle="bold"
        android:letterSpacing="0.04"
        android:layout_marginTop="18dp"
        app:layout_constraintTop_toBottomOf="@id/logo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Tagline -->
    <TextView
        android:id="@+id/tagline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Your style, your story."
        android:textColor="@color/dark_brown"
        android:textSize="16sp"
        android:fontFamily="serif"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/app_name"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Decorative Divider -->
    <View
        android:layout_width="85dp"
        android:layout_height="1dp"
        android:background="@color/beige"
        android:layout_marginTop="28dp"
        app:layout_constraintTop_toBottomOf="@id/tagline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Footer -->
    <TextView
        android:id="@+id/footer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="FASHION  •  AI  •  YOUR WARDROBE"
        android:textColor="@color/soft_brown"
        android:textSize="11sp"
        android:letterSpacing="0.12"
        android:fontFamily="sans-serif"
        android:layout_marginBottom="38dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>