
<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="STYLE DISCOVERY"
            android:textColor="@color/soft_brown"
            android:textSize="11sp"
            android:letterSpacing="0.16"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Explore Fashion"
            android:textColor="@color/text_black"
            android:textSize="30sp"
            android:textStyle="bold"
            android:fontFamily="serif"
            android:layout_marginTop="7dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Find pieces that express your personal style."
            android:textColor="@color/soft_brown"
            android:textSize="14sp"
            android:layout_marginTop="5dp" />

        <EditText
            android:id="@+id/et_explore_search"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/search_background"
            android:drawableStart="@android:drawable/ic_menu_search"
            android:drawablePadding="12dp"
            android:hint="Search clothing..."
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:singleLine="true"
            android:textColor="@color/text_black"
            android:textColorHint="@color/soft_brown"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Browse Categories"
            android:textColor="@color/text_black"
            android:textSize="19sp"
            android:textStyle="bold"
            android:fontFamily="serif"
            android:layout_marginTop="27dp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_explore_all"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:text="All"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:backgroundTint="@color/dark_brown" />

                <Button
                    android:id="@+id/btn_explore_tops"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:layout_marginStart="8dp"
                    android:text="Tops"
                    android:textAllCaps="false"
                    android:textColor="@color/dark_brown"
                    android:backgroundTint="@color/beige" />

                <Button
                    android:id="@+id/btn_explore_bottoms"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:layout_marginStart="8dp"
                    android:text="Bottoms"
                    android:textAllCaps="false"
                    android:textColor="@color/dark_brown"
                    android:backgroundTint="@color/beige" />

                <Button
                    android:id="@+id/btn_explore_dresses"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:layout_marginStart="8dp"
                    android:text="Dresses"
                    android:textAllCaps="false"
                    android:textColor="@color/dark_brown"
                    android:backgroundTint="@color/beige" />

                <Button
                    android:id="@+id/btn_explore_shoes"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:layout_marginStart="8dp"
                    android:text="Shoes"
                    android:textAllCaps="false"
                    android:textColor="@color/dark_brown"
                    android:backgroundTint="@color/beige" />

                <Button
                    android:id="@+id/btn_explore_accessories"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:layout_marginStart="8dp"
                    android:text="Accessories"
                    android:textAllCaps="false"
                    android:textColor="@color/dark_brown"
                    android:backgroundTint="@color/beige" />

            </LinearLayout>
        </HorizontalScrollView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Curated For You"
            android:textColor="@color/text_black"
            android:textSize="19sp"
            android:textStyle="bold"
            android:fontFamily="serif"
            android:layout_marginTop="28dp" />

        <TextView
            android:id="@+id/tv_explore_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No fashion items found."
            android:textColor="@color/soft_brown"
            android:textSize="14sp"
            android:gravity="center"
            android:padding="30dp"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_explore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:nestedScrollingEnabled="false" />

    </LinearLayout>

</ScrollView>
